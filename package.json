{
  "name": "decomoji-finder",
  "version": "3.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs --watch",
    "serve": "node scripts/serve.mjs",
    "build:css": "tailwindcss --input styles/app.css --output public/app.css --minify",
    "copy:assets": "node scripts/copy.mjs",
    "update:decomoji": "rm -rf node_modules/decomoji && npm i -d decomoji/decomoji && npm run postinstall",
    "postinstall": "npm run copy:assets && npm run build:css"
  },
  "dependencies": {
    "decomoji": "github:decomoji/decomoji"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.16",
    "@tanstack/vue-virtual": "^3.13.35",
    "vue": "^3.5.23"
  }
}
