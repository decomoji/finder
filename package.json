{
  "name": "decomoji-finder",
  "version": "3.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx --yes serve public",
    "update:decomoji": "rm -rf node_modules/decomoji && npm i -d decomoji/decomoji && npm run postinstall",
    "postinstall": "cpx 'node_modules/decomoji/decomoji/{basic,extra,explicit}/*.png' public/decomoji/ && cpx 'node_modules/decomoji/configs/v5_{all,versions}.json' public/configs/"
  },
  "dependencies": {
    "decomoji": "github:decomoji/decomoji"
  },
  "devDependencies": {
    "cpx2": "^9.0.0"
  }
}
